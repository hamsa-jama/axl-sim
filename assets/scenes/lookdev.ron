// Look-dev scene (SPEC.md, "Look-dev scene"): a 2x4 brick, a 7-hole beam, a 24-tooth gear,
// a 56 mm wheel and the Rover on the grid floor. Every object is a real part from assets/parts,
// hand-placed here until the builder (milestone M4) can assemble the Rover itself.
// Lengths are millimetres, angles degrees (rotation applied as Rz * Ry * Rx), Z up, floor at z = 0.
// Part frames: bricks have their origin at the centre of the bottom face; beams at the centre of
// the first hole; gears and wheels at their centre with the axis along Z; motors at the centre of
// the output face with the shaft along +Y; axles start half a unit before their first slot.
(
    version: 1,
    camera: (
        focus_mm: (0.0, 10.0, 12.0),
        yaw_deg: -52.0,
        pitch_deg: 26.0,
        distance_mm: 520.0,
    ),
    items: [
        (
            name: "brick_2x4",
            pos_mm: (58.9, -42.9, 0.0),
            yaw_deg: 20.0,
            parts: [(part: "brick_2x4", color: "red")],
        ),
        (
            name: "beam_7",
            pos_mm: (-9.4, 98.1, 3.6),
            yaw_deg: -35.0,
            parts: [(part: "beam_7", color: "blue")],
        ),
        (
            name: "gear_24",
            pos_mm: (3.5, 28.1, 1.6),
            yaw_deg: 0.0,
            parts: [(part: "gear_24", color: "yellow")],
        ),
        (
            name: "wheel_56",
            pos_mm: (74.4, 83.6, 28.0),
            yaw_deg: 0.0,
            parts: [(part: "wheel_56", rot_deg: (90.0, 0.0, 200.0), color: "white")],
        ),
        (
            // The Rover: hub on two medium motors, 56 mm wheels on 3-unit axles, a ball caster
            // on a short brick stack at the back, an ultrasonic sensor on the front of the hub
            // and a colour sensor looking down under it. Robot frame: +X forward, +Y left.
            name: "rover",
            pos_mm: (-64.7, -63.3, 0.0),
            yaw_deg: 0.0,
            parts: [
                (part: "hub", pos_mm: (0.0, 0.0, 40.0), color: "white"),
                (part: "motor_medium", pos_mm: (0.0, 56.0, 28.0), color: "light_grey"),
                (part: "motor_medium", pos_mm: (0.0, -56.0, 28.0), rot_deg: (0.0, 0.0, 180.0), color: "light_grey"),
                (part: "axle_3", pos_mm: (0.0, 52.0, 28.0), rot_deg: (0.0, 0.0, 90.0), color: "dark_grey"),
                (part: "axle_3", pos_mm: (0.0, -52.0, 28.0), rot_deg: (0.0, 0.0, -90.0), color: "dark_grey"),
                (part: "wheel_56", pos_mm: (0.0, 68.0, 28.0), rot_deg: (90.0, 0.0, 0.0), color: "white"),
                (part: "wheel_56", pos_mm: (0.0, -68.0, 28.0), rot_deg: (-90.0, 0.0, 0.0), color: "white"),
                (part: "caster_ball", pos_mm: (-24.0, 0.0, 0.0), color: "dark_grey"),
                (part: "brick_2x2", pos_mm: (-24.0, 0.0, 20.8), color: "dark_grey"),
                (part: "brick_2x2", pos_mm: (-24.0, 0.0, 30.4), color: "dark_grey"),
                (part: "sensor_ultrasonic", pos_mm: (24.0, 0.0, 62.4), color: "dark_grey"),
                (part: "sensor_color", pos_mm: (24.0, 0.0, 14.4), color: "dark_grey"),
            ],
        ),
    ],
)
