                (shape: Cylinder(radius_mm: 2.4, length_mm: 7.3, axis: Y), offset_mm: (8.0, 0.0, 3.6), color: "black", material: Abs),
                (shape: Cylinder(radius_mm: 2.4, length_mm: 7.3, axis: Y), offset_mm: (16.0, 0.0, 3.6), color: "black", material: Abs),
