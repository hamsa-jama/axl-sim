                (shape: Cylinder(radius_mm: 17.0, length_mm: 14.6, axis: Y), offset_mm: (0.0, 0.0, 28.0), color: "white", material: Abs),
                (shape: Cylinder(radius_mm: 4.0, length_mm: 15.2, axis: Y), offset_mm: (0.0, 0.0, 28.0), color: "dark_grey", material: Abs),
